From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 18:46:48 +0200
Subject: [PATCH 2/2] ci: run backend checks on GitHub Actions (PostgreSQL 17,
 Python 3.13 and 3.14)

Approved by the product owner: the only file outside Qeeva-Backend. Read-only token, no secrets.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016XZgY67wRt6nPCj5ueMP8y
---
 .github/workflows/backend-ci.yml | 55 ++++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)
 create mode 100644 .github/workflows/backend-ci.yml

diff --git a/.github/workflows/backend-ci.yml b/.github/workflows/backend-ci.yml
new file mode 100644
index 0000000..3a5f454
--- /dev/null
+++ b/.github/workflows/backend-ci.yml
@@ -0,0 +1,55 @@
+# Runs every check on the backend for each push and pull request that touches it.
+# Free for public repositories; private repositories get a monthly free-minutes allowance.
+name: Backend CI
+
+on:
+  push:
+    paths:
+      - "Qeeva-Backend/**"
+      - ".github/workflows/backend-ci.yml"
+  pull_request:
+    paths:
+      - "Qeeva-Backend/**"
+      - ".github/workflows/backend-ci.yml"
+
+permissions:
+  contents: read # the job only reads the code; it gets no write access
+
+jobs:
+  backend:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        python-version: ["3.13", "3.14"]
+    defaults:
+      run:
+        working-directory: Qeeva-Backend
+    services:
+      postgres:
+        image: postgres:17 # same major version as the Supabase project
+        env:
+          POSTGRES_PASSWORD: test
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U postgres"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+    env:
+      QEEVA_TEST_DATABASE_URL: postgresql://postgres:test@localhost:5432/postgres
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+          cache: pip
+          cache-dependency-path: Qeeva-Backend/requirements-dev.txt
+      - run: pip install -r requirements-dev.txt
+      - run: ruff check .
+      - run: ruff format --check .
+      - run: mypy .
+      - run: python manage.py makemigrations --check --dry-run --settings=core.settings_test
+      # -rs lists any skipped test with its reason; with the database variable set, none may skip.
+      - run: python -m pytest -rs
