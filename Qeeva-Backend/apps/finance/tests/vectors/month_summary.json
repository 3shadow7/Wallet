{
  "about": "Shared test vectors for the month formulas. Money is in minor units of THOUSANDTHS (3 decimals, D-149): 500 is 500000. The Python code runs them today; the Angular FinancialCalculatorService must give the same numbers (plan 20261114-frontend-backend-alignment, step 1). The formulas only add, subtract and compare, so they give the same results whatever the scale. Keys of 'expected' are the MonthSummary fields.",
  "cases": [
    {
      "name": "empty month",
      "income": 0,
      "cards": [],
      "expected": {"planned_outflow": 0, "free_money": 0, "real_expense": 0, "savings_balance": 0, "actual_saved": 0, "overspend": 0, "saving_shortfall": 0}
    },
    {
      "name": "income only",
      "income": 500000,
      "cards": [],
      "expected": {"planned_outflow": 0, "free_money": 500000, "real_expense": 0, "savings_balance": 500000, "actual_saved": 500000, "overspend": 0, "saving_shortfall": 0}
    },
    {
      "name": "healthy month: income 500, burn 200, tax 50, saving 100",
      "income": 500000,
      "cards": [
        {"type": "burn", "amount": 200000},
        {"type": "tax", "amount": 50000},
        {"type": "saving", "amount": 100000}
      ],
      "expected": {"planned_outflow": 350000, "free_money": 150000, "real_expense": 250000, "savings_balance": 250000, "actual_saved": 250000, "overspend": 0, "saving_shortfall": 0}
    },
    {
      "name": "the owner's example: income 500, planned outflow 550 of which saving 100",
      "income": 500000,
      "cards": [
        {"type": "burn", "amount": 450000},
        {"type": "saving", "amount": 100000}
      ],
      "expected": {"planned_outflow": 550000, "free_money": -50000, "real_expense": 450000, "savings_balance": 50000, "actual_saved": 50000, "overspend": 0, "saving_shortfall": 50000}
    },
    {
      "name": "real spending is more than income: nothing is saved, whole saving target is missed",
      "income": 500000,
      "cards": [
        {"type": "burn", "amount": 550000},
        {"type": "saving", "amount": 100000}
      ],
      "expected": {"planned_outflow": 650000, "free_money": -150000, "real_expense": 550000, "savings_balance": -50000, "actual_saved": 0, "overspend": 50000, "saving_shortfall": 100000}
    },
    {
      "name": "spending exactly equals income",
      "income": 500000,
      "cards": [
        {"type": "burn", "amount": 400000},
        {"type": "tax", "amount": 100000},
        {"type": "saving", "amount": 100000}
      ],
      "expected": {"planned_outflow": 600000, "free_money": -100000, "real_expense": 500000, "savings_balance": 0, "actual_saved": 0, "overspend": 0, "saving_shortfall": 100000}
    },
    {
      "name": "leftover is bigger than the saving target: no shortfall",
      "income": 1000000,
      "cards": [
        {"type": "burn", "amount": 200000},
        {"type": "saving", "amount": 100000}
      ],
      "expected": {"planned_outflow": 300000, "free_money": 700000, "real_expense": 200000, "savings_balance": 800000, "actual_saved": 800000, "overspend": 0, "saving_shortfall": 0}
    },
    {
      "name": "ignored cards do not count",
      "income": 500000,
      "cards": [
        {"type": "burn", "amount": 200000},
        {"type": "burn", "amount": 999990, "ignored": true},
        {"type": "tax", "amount": 999990, "ignored": true},
        {"type": "saving", "amount": 999990, "ignored": true}
      ],
      "expected": {"planned_outflow": 200000, "free_money": 300000, "real_expense": 200000, "savings_balance": 300000, "actual_saved": 300000, "overspend": 0, "saving_shortfall": 0}
    },
    {
      "name": "saving only, no income",
      "income": 0,
      "cards": [{"type": "saving", "amount": 100000}],
      "expected": {"planned_outflow": 100000, "free_money": -100000, "real_expense": 0, "savings_balance": 0, "actual_saved": 0, "overspend": 0, "saving_shortfall": 100000}
    },
    {
      "name": "thousandths are exact (no float rounding)",
      "income": 100010,
      "cards": [
        {"type": "burn", "amount": 33},
        {"type": "burn", "amount": 66},
        {"type": "tax", "amount": 1}
      ],
      "expected": {"planned_outflow": 100, "free_money": 99910, "real_expense": 100, "savings_balance": 99910, "actual_saved": 99910, "overspend": 0, "saving_shortfall": 0}
    },
    {
      "name": "large amounts fit",
      "income": 90000000000000,
      "cards": [{"type": "burn", "amount": 89999999999990}],
      "expected": {"planned_outflow": 89999999999990, "free_money": 10, "real_expense": 89999999999990, "savings_balance": 10, "actual_saved": 10, "overspend": 0, "saving_shortfall": 0}
    }
  ]
}
