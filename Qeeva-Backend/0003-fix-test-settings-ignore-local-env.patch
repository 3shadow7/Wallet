From 5e57d8b1a2a94d10b073b8352234035877e673cb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 17:43:00 +0200
Subject: [PATCH] fix(backend): make test settings independent of a local .env
 file

pytest read the developer's .env (DJANGO_DEBUG=true), so the cookie-security test
failed on machines that had a local .env. Test settings now assign their values
unconditionally, so results are identical on every machine.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016XZgY67wRt6nPCj5ueMP8y
---
 Qeeva-Backend/core/settings_test.py | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/Qeeva-Backend/core/settings_test.py b/Qeeva-Backend/core/settings_test.py
index f08d76c..c7a4f3c 100644
--- a/Qeeva-Backend/core/settings_test.py
+++ b/Qeeva-Backend/core/settings_test.py
@@ -1,15 +1,18 @@
 """Settings used ONLY by the automated tests and the type checker.
 
-Sets fake, throwaway values before the real settings are imported, so tests never read a
-real ``.env`` file and never touch a real database or Supabase project.
+The tests must give the same result on every machine, so these values are assigned
+unconditionally (not "if missing"). They win over a developer's local ``.env`` file,
+because real environment variables always take priority over that file.
 """
 
 import os
 
-os.environ.setdefault(
-    "DJANGO_SECRET_KEY", "test-only-secret-key-never-used-outside-tests-0123456789"
-)
-os.environ.setdefault("DATABASE_URL", "postgresql://test:test@localhost:5432/test")
-os.environ.setdefault("SUPABASE_URL", "https://testproject.supabase.co")
+os.environ["DJANGO_SECRET_KEY"] = "test-only-secret-key-never-used-outside-tests-0123456789"
+os.environ["DJANGO_DEBUG"] = "false"
+os.environ["DJANGO_ALLOWED_HOSTS"] = "testserver,localhost"
+os.environ["DATABASE_URL"] = "postgresql://test:test@localhost:5432/test"
+os.environ["SUPABASE_URL"] = "https://testproject.supabase.co"
+os.environ["DB_CONN_MAX_AGE"] = "0"
+os.environ["DB_DISABLE_SERVER_SIDE_CURSORS"] = "false"
 
 from core.settings import *
-- 
