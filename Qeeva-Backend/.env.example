# Local development defaults to SQLite.
# For Supabase PostgreSQL, set DB_ENGINE=django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3

# Supabase PostgreSQL connection (use the direct connection or session pooler).
# Do not use the transaction pooler for Django migrations.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
