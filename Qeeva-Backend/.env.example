# Copy this file to ".env" and fill in real values. ".env" is ignored by Git.
# In production, set these as real environment variables instead of using a file.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# "true" only on your own machine. Must be false (or unset) in production.
DJANGO_DEBUG=false

# Comma-separated host names this server answers to, e.g. localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL connection string (use the SESSION pooler or the direct connection).
# Example shape: postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Special characters in the password must be URL-encoded (for example @ becomes %40).
DATABASE_URL=

# Optional database tuning.
# DB_CONN_MAX_AGE=0                      # seconds a connection is reused (0 = close after each request)
# DB_DISABLE_SERVER_SIDE_CURSORS=false   # set to true ONLY if you use Supabase's transaction pooler (port 6543)

# Your Supabase project URL (no trailing path), e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
